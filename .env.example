# Application Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/draindna?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/draindna?retryWrites=true&w=majority

# Optional: Production Cloud Image Storage (AWS S3 or Cloudinary)
# If omitted, uploaded evidence images are safely stored on the local server in /uploads/evidence/
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=your_bucket_name

